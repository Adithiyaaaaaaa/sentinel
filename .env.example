# All paths below are local to the API process. Use forward slashes on Windows.
SENTINEL_DATABASE_URL=sqlite:///.sentinel/sentinel.db
# Omit this variable to allow the SENTINEL project root. [] denies all roots.
# Relative roots resolve from the directory where the API is launched.
SENTINEL_ALLOWED_ROOTS=["."]
SENTINEL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Leave unset to use the bundled examples/sample-repository fixture.
# SENTINEL_DEMO_PATH=C:/Users/you/projects/sentinel/examples/sample-repository

# Used by the Next.js server, never exposed as a browser-side cloud endpoint.
SENTINEL_API_URL=http://127.0.0.1:8000

# Optional local AI; no remote/cloud endpoint is accepted.
SENTINEL_OLLAMA_URL=http://127.0.0.1:11434
SENTINEL_OLLAMA_TIMEOUT=180

# Optional Docker-only test validation. Use an installed Linux image ID, not a tag.
# SENTINEL_SANDBOX_IMAGE=sha256:<64 hexadecimal characters>
SENTINEL_SANDBOX_TIMEOUT=60
